{
	"compatibility_date": "2026-05-06",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "sorc-app",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "sorc_db",
			"database_name": "sorc-db",
			"database_id": "520f3196-06c5-4ecd-bf26-6531ea66d15c",
			"remote": true
		},
		{
			"binding": "Y",
			"database_name": "sorc-rpg",
			"database_id": "256008d3-fd04-4766-8883-0796624b9cb5",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"bucket_name": "sorc-files",
			"binding": "sorc_files",
			"remote": true
		}
	]
}